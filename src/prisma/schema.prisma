generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  refreshToken String?
  createdAt    DateTime @default(now())
  resumes      Resume[]

  @@map("users")
}

model Resume {
  id             String          @id @default(uuid())
  userId         String
  title          String
  summary        String
  templateStyle  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  certifications Certification[]
  contacts       Contact[]
  educations     Education[]
  experiences    Experience[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         Skill[]

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])

  @@map("resumes")
}

model Contact {
  id        String   @id @default(uuid())
  image     String
  firstName String
  lastName  String
  jobTitle  String
  phone     String
  country   String
  city      String
  state     String
  email     String
  pincode   String
  linkedin  String?
  website   String?
  dob       DateTime
  resumeId  String?
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("contacts")
}

model Experience {
  id                String  @id @default(uuid())
  jobTitle          String
  companyName       String
  country           String
  city              String
  state             String
  startMonth        Int
  startYear         Int
  endMonth          Int?
  endYear           Int?
  currentlyWorkHere Boolean
  resumeId          String
  resume            Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])

  @@map("experiences")
}

model Education {
  id              String @id @default(uuid())
  schoolName      String
  schoolLocation  String
  degreeOrProgram String
  fieldOfStudy    String
  graduationMonth Int
  graduationYear  Int
  resumeId        String
  resume          Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])

  @@map("educations")
}

model Certification {
  id         String    @id @default(uuid())
  name       String
  issuer     String
  issueDate  DateTime
  expiryDate DateTime?
  resumeId   String
  resume     Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])

  @@map("certifications")
}

model Skill {
  id          String      @id @default(uuid())
  name        String
  proficiency Proficiency
  resumeId    String
  resume      Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])

  @@map("skills")
}

enum Proficiency {
  Beginner
  Intermediate
  Advanced
}
